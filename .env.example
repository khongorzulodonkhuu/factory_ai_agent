# Provider key for the models below
ANTHROPIC_API_KEY=
# Only when the key comes from a gateway/proxy (e.g. a hackathon key that is not sk-ant-...)
# ANTHROPIC_BASE_URL=https://<gateway-host>
# Other providers need their own key and package (see README, section 8)

# Models as "<provider>:<model>" (any LangChain init_chat_model id)
# cheap: requirements, design tokens, tests   strong: architecture, code, fixes
FACTORY_CHEAP_MODEL=anthropic:claude-haiku-5-5
FACTORY_STRONG_MODEL=anthropic:claude-opus-5-5
# fixer starts here and escalates to the strong model after FACTORY_FIX_ESCALATE_AFTER failed iterations
FACTORY_FIX_MODEL=anthropic:claude-sonnet-5-5
FACTORY_FIX_ESCALATE_AFTER=2

# Guardrails: the run stops (and reports) when either budget is reached
FACTORY_USD_BUDGET=10   # hackathon limit is $15 per run; keep headroom
FACTORY_TOKEN_BUDGET=1500000
FACTORY_MAX_FIX_ITERATIONS=5

# "gh-pages" publishes the built app to this repo's gh-pages branch; "none" only builds it
FACTORY_DEPLOY=none
